# Backend API URL (change to your production backend URL for deployment)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth Client ID (from Google Cloud Console → Credentials → OAuth 2.0 Client IDs)
# Add your production domain to "Authorized JavaScript Origins" before deploying
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
