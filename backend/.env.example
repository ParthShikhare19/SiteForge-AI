# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_32_char_random_hex

# ── AI providers ──────────────────────────────────────────────────────────────
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-large-latest
MISTRAL_FAST_MODEL=mistral-small-latest
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
UNSPLASH_ACCESS_KEY=

# ── File storage (blank = local disk at static/uploads/) ─────────────────────
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# ── Rate limiter (blank = in-memory, lost on restart) ────────────────────────
REDIS_URL=redis://default:gQAAAAAAAekcAAIgcDJkNGM0NWMzYTYzN2M0MTI4OTNiMzE1YmQ5MGRmNzBkNQ@refined-beetle-125212.upstash.io:6379

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend-domain.com
